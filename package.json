{
  "name": "inat-battler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "lint": "node --check src/index.js && node --check src/app-client.js",
    "simulate": "node scripts/simulate.mjs",
    "db:migrate:local": "wrangler d1 migrations apply inat_battler --local",
    "db:migrate:remote": "wrangler d1 migrations apply inat_battler --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "h3-js": "^4.4.0"
  }
}
